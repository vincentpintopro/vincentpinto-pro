---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import { SITE, HOME } from "@consts";
import ArrowCard from "@components/ArrowCard.astro";
import { getCollection } from "astro:content";

const blog = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);
---

<Layout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <aside data-pagefind-ignore>
      <div class="space-y-16">
        <section class="space-y-6">
          <div class="space-y-4">
            <h1 class="animate text-3xl font-semibold text-black dark:text-white">
              Conseils pour mieux vendre vos activités outdoor
            </h1>
            <article class="animate">
              <p>
                Des conseils concrets pour les pros de l’outdoor et de
                l’aventure, tirés de ce que j’ai vu marcher, et échouer, sur
                le terrain à travers le monde depuis 2015.
              </p>
            </article>
          </div>

          <img
            src="/header-accueil-2000.jpg"
            srcset="/header-accueil-800.jpg 800w, /header-accueil-1400.jpg 1400w, /header-accueil-2000.jpg 2000w"
            sizes="(min-width: 640px) 616px, 100vw"
            alt="Vincent Pinto en randonnée dans le Caucase géorgien"
            width="2400"
            height="1000"
            class="animate h-auto w-full rounded-lg"
          />

          <article class="animate space-y-4">
            <p>
              J’aide les structures outdoor et aventure (écoles de plongée,
              guides de haute montagne, moniteurs de canyoning, de surf, clubs
              sportifs, et j’en passe) à mieux vendre en ligne : comprendre
              leur marché, être visibles sur Google et dans les IA, choisir
              les bons outils, construire des produits qui donnent envie,
              toucher de nouveaux clients, élargir leur saison.
            </p>
          </article>
        </section>

        <section class="animate space-y-6">
          <div class="flex flex-wrap items-center justify-between gap-y-2">
            <h2 class="font-semibold text-black dark:text-white">
              Derniers articles
            </h2>
            <Link href="/blog/"> Voir tous les articles </Link>
          </div>
          <ul class="not-prose flex flex-col gap-4">
            {
              blog.map((post) => (
                <li>
                  <ArrowCard entry={post} />
                </li>
              ))
            }
          </ul>
        </section>
      </div>
    </aside>
  </Container>
</Layout>
