---
import Head from "@components/Head.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Pagefind from "@components/PageFind.astro";
import { SITE } from "@consts";
import { synonymesPour, texteIndexable } from "@lib/synonymes";

type Props = {
  title: string;
  description: string;
  article?: {
    headline: string;
    datePublished: Date;
    dateModified: Date;
  };
};

const { title, description, article } = Astro.props;

const html = await Astro.slots.render("default");
const synonymes = synonymesPour(texteIndexable(html));
---

<!doctype html>
<html lang="fr">
  <head>
    <Head
      title={`${title} | ${SITE.TITLE}`}
      description={description}
      article={article}
      synonymes={synonymes}
    />
  </head>
  <body>
    <noscript>
      <style>
        .animate{
          opacity:1;
          translate: var(--tw-translate-x) calc(var(--spacing) * 0);
        }
      </style>
    </noscript>
    <Header />
    <main data-pagefind-body>
      <Fragment set:html={html} />
    </main>
    <Footer />
    <Pagefind />
  </body>
</html>
