---
import Container from "@components/Container.astro";
import { SITE } from "@consts";
import BackToTop from "@components/BackToTop.astro";
---

<footer class="animate">
  <Container>
    <div
      class="flex flex-col-reverse items-start gap-4 sm:flex-row sm:items-center sm:justify-between"
    >
      <div>
        &copy; {new Date().getFullYear()} {SITE.TITLE} |{" "}
        <a
          href="/mentions-legales/"
          class="underline underline-offset-[3px] decoration-black/30 hover:decoration-black/50 dark:decoration-white/30 dark:hover:decoration-white/50 transition-colors duration-300 ease-in-out"
          >Mentions légales</a
        >
      </div>
      <BackToTop />
    </div>
  </Container>
</footer>
